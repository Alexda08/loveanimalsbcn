{% comment %}
  Píldora (enlace): botoncito redondeado con borde fino, como las píldoras de
  compartir de la ficha de animal (Instagram/WhatsApp/Copiar enlace). Se usa en
  la card «Comparte en redes» de Colabora y donde haga falta un enlace suave.
{% endcomment %}

<a
  class="pildora"
  {% if block.settings.enlace != blank %}
    href="{{ block.settings.enlace }}"
    {% if block.settings.nueva_pestana %}target="_blank" rel="noopener"{% endif %}
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{- block.settings.texto -}}
</a>

{% stylesheet %}
  .pildora {
    display: inline-block;
    font-family: var(--font-accent--family);
    font-weight: 500;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: 999px;
    padding: 0.55em 1.1em;
    background: transparent;
    color: inherit;
    text-decoration: none;
    transition: all 0.13s ease;
  }

  .pildora:hover {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }

  .pildora:focus-visible {
    outline: 3px solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Píldora (enlace)",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "texto",
      "label": "Texto",
      "default": "Instagram"
    },
    {
      "type": "url",
      "id": "enlace",
      "label": "Enlace"
    },
    {
      "type": "checkbox",
      "id": "nueva_pestana",
      "label": "Abrir en pestaña nueva",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Píldora (enlace)"
    }
  ]
}
{% endschema %}
