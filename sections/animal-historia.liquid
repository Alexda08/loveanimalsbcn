{% comment %}
  Ficha de animal (banda inferior): su historia, su carácter y la caja de licencia PPP
  (solo si el animal es PPP). Se usa en templates/metaobject/animal.json.
{% endcomment %}

{%- liquid
  assign animal = metaobject
  assign nombre = animal.nombre.value
-%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    {% render 'paleta-vars' %}
    --animal-historia-padding-top: {{ section.settings.padding-block-start }}px;
    --animal-historia-padding-bottom: {{ section.settings.padding-block-end }}px;
    {%- if section.settings.background_color != blank %}
    --animal-historia-bg: var(--color-background);
    {%- endif %}
  }
</style>

{%- if animal != blank -%}
  {%- assign tiene_historia = false -%}
  {%- if animal.historia.value != blank or animal.caracter.value.size > 0 or animal.ppp.value -%}
    {%- assign tiene_historia = true -%}
  {%- endif -%}

  {%- if tiene_historia -%}
    <div class="animal-historia{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
      <div class="animal-historia__wrap">
        {%- if animal.historia.value != blank -%}
          <div class="animal-historia__block">
            <span class="animal-historia__head">Su historia</span>
            <div class="animal-historia__texto">
              {{ animal.historia.value | metafield_tag }}
            </div>
          </div>
        {%- endif -%}

        {%- if animal.caracter.value.size > 0 -%}
          <div class="animal-historia__block">
            <span class="animal-historia__head">Su carácter</span>
            <div class="animal-historia__tags">
              {%- for rasgo in animal.caracter.value -%}
                <span class="animal-historia__tag">{{ rasgo | downcase }}</span>
              {%- endfor -%}
            </div>
            {%- if section.settings.nota_etologia != blank -%}
              <p class="animal-historia__nota">{{ section.settings.nota_etologia }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if animal.ppp.value -%}
          <div class="animal-historia__block">
            {% render 'licencia-ppp', modo: 'caja', nombre: nombre, guia_url: section.settings.guia_ppp %}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .animal-historia {
    background: var(--animal-historia-bg, var(--la-nude, var(--color-background)));
    padding-block: var(--animal-historia-padding-top) var(--animal-historia-padding-bottom);
    color: var(--color-foreground);
  }

  .animal-historia__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .animal-historia__block {
    max-width: 820px;
    margin: 0 auto 44px;
  }

  .animal-historia__block:last-child {
    margin-bottom: 0;
  }

  .animal-historia__head {
    font-family: var(--font-accent--family);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    letter-spacing: 0.06em;
    display: inline-block;
    border-bottom: 2px solid var(--la-wine, var(--color-foreground));
    padding-bottom: 6px;
  }

  .animal-historia__texto {
    margin-top: 14px;
    font-size: 0.98rem;
  }

  .animal-historia__texto p {
    margin: 0 0 14px;
  }

  .animal-historia__texto p:last-child {
    margin-bottom: 0;
  }

  .animal-historia__texto b,
  .animal-historia__texto strong {
    color: var(--la-wine, var(--color-foreground));
  }

  .animal-historia__tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .animal-historia__tag {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-foreground);
    background: var(--la-cream, var(--color-background));
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: 999px;
    padding: 0.4em 1.2em;
  }

  .animal-historia__nota {
    margin: 16px 0 0;
    font-size: 0.85rem;
    color: var(--la-wine-soft, var(--color-foreground));
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Historia y carácter",
  "settings": [
    {
      "type": "paragraph",
      "content": "Muestra la historia, el carácter y la licencia PPP (si aplica) del metaobjeto «animal»."
    },
    {
      "type": "text",
      "id": "nota_etologia",
      "label": "Nota del equipo de etología",
      "default": "Valoración realizada por nuestro equipo de etología canina, que os asesorará durante la visita sobre el encaje con vuestra familia."
    },
    {
      "type": "url",
      "id": "guia_ppp",
      "label": "Enlace a la guía completa de la licencia PPP"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "enabled_on": {
    "templates": ["metaobject"]
  }
}
{% endschema %}
