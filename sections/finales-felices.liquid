{% comment %}
  Muro de finales felices.

  Dos modos:
  - Con bloques «Animal adoptado»: eliges y ordenas exactamente qué animales salen
    (el diseño de referencia muestra 4), con frase opcional de su familia.
  - Sin bloques: se rellena solo con los animales en estado «adoptado» (el muro
    crece con cada adopción sin tocar el theme editor).
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    {% render 'paleta-vars' %}
    --felices-padding-top: {{ section.settings.padding-block-start }}px;
    --felices-padding-bottom: {{ section.settings.padding-block-end }}px;
    --felices-cols: {{ section.settings.columns | default: 4 }};
    --felices-cols-mobile: {{ section.settings.mobile_columns | default: '1' }};
    --felices-gap: {{ section.settings.columns_gap | default: 20 }}px;
    {%- if section.settings.background_color != blank %}
    --felices-bg: var(--color-background);
    {%- endif %}
  }
</style>

{%- capture muro -%}
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign elegido = block.settings.animal
        if elegido != blank
          render 'feliz-card', animal: elegido, frase: block.settings.frase, mostrar_sello: section.settings.mostrar_sello, mostrar_anio: section.settings.mostrar_anio, shopify_attributes: block.shopify_attributes, avisar_no_adoptado: true
        elsif request.design_mode
          echo '<div class="feliz-card feliz-card--vacia" '
          echo block.shopify_attributes
          echo '><span class="feliz-card__elige">🐾<br>Elige un animal en los ajustes del bloque</span></div>'
        endif
      -%}
    {%- endfor -%}
  {%- else -%}
    {%- liquid
      assign max = section.settings.max_animales | default: 8
      assign adoptados_count = 0
      for a in shop.metaobjects.animal.values
        if adoptados_count >= max
          break
        endif
        assign estado = a.estado.value | downcase | strip
        if estado == 'adoptado'
          assign adoptados_count = adoptados_count | plus: 1
          render 'feliz-card', animal: a, mostrar_sello: section.settings.mostrar_sello, mostrar_anio: section.settings.mostrar_anio
        endif
      endfor
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- assign muro_limpio = muro | strip -%}
{%- if muro_limpio != blank or request.design_mode -%}
  <div class="felices{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
    <div class="felices__wrap{% if section.settings.section_width == 'full-width' %} felices__wrap--full{% endif %}">
      <div class="felices__head">
        {%- if section.settings.fina != blank -%}
          <p class="felices__fina">{{ section.settings.fina }}</p>
        {%- endif -%}
        {%- if section.settings.titulo != blank -%}
          <h2 class="felices__titulo">{{ section.settings.titulo }}</h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="felices__lead">{{ section.settings.lead }}</p>
        {%- endif -%}
      </div>

      {%- if muro_limpio != blank -%}
        <div class="felices__grid{% if section.settings.girar %} felices__grid--girado{% endif %}">
          {{ muro }}
        </div>
      {%- else -%}
        <p class="felices__vacio">Añade bloques «Animal adoptado» o marca animales con estado «adoptado» y aparecerán aquí.</p>
      {%- endif -%}

      {%- if section.settings.nota != blank -%}
        <p class="felices__nota">{{ section.settings.nota }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .felices {
    background: var(--felices-bg, var(--la-nude, var(--color-background)));
    padding-block: var(--felices-padding-top) var(--felices-padding-bottom);
    color: var(--color-foreground);
  }

  .felices__wrap {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .felices__wrap--full {
    max-width: none;
  }

  .felices__head {
    text-align: center;
    margin-bottom: 46px;
  }

  .felices__fina {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    color: var(--la-wine, var(--color-foreground));
    margin: 0;
  }

  .felices__titulo {
    font-family: var(--font-heading--family);
    font-weight: 500;
    text-transform: uppercase;
    font-size: clamp(1.9rem, 4.6vw, 3.1rem);
    letter-spacing: 0.22em;
    margin: 4px 0 0;
    margin-right: -0.22em;
  }

  .felices__lead {
    max-width: 44em;
    margin: 14px auto 0;
    font-size: 0.98rem;
  }

  .felices__grid {
    display: grid;
    grid-template-columns: repeat(var(--felices-cols, 4), 1fr);
    gap: var(--felices-gap, 20px);
  }

  @media (max-width: 960px) {
    .felices__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .felices__grid {
      grid-template-columns: repeat(var(--felices-cols-mobile, 1), 1fr);
    }
  }

  .feliz-card {
    background: var(--la-white, var(--color-background));
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: 4px;
    padding: 10px 10px 16px;
    text-align: center;
    box-shadow: 0 8px 20px rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .felices__grid--girado .feliz-card {
    transform: rotate(-0.6deg);
  }

  .felices__grid--girado .feliz-card:nth-child(even) {
    transform: rotate(0.6deg);
  }

  .feliz-card__ph {
    overflow: hidden;
  }

  .feliz-card__img {
    aspect-ratio: 1 / 0.9;
    object-fit: cover;
    width: 100%;
    height: auto;
    display: block;
  }

  .feliz-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 0.9;
    font-size: 2rem;
    background: var(--color-background);
  }

  .feliz-card__nombre {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-weight: 600;
    font-size: 1.3rem;
    margin: 10px 0 0;
  }

  .feliz-card__sello {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--font-accent--family);
    font-weight: 500;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--la-wine, var(--color-foreground));
    border: 1.5px solid var(--la-wine, var(--color-foreground));
    border-radius: 3px;
    padding: 0.35em 0.8em;
    transform: rotate(-2deg);
  }

  .feliz-card__frase {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--la-wine-soft, var(--color-foreground));
    margin: 8px 0 0;
  }

  .feliz-card__aviso {
    display: block;
    margin-top: 8px;
    font-family: var(--font-accent--family);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--la-gold, var(--color-foreground));
  }

  .feliz-card--vacia {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    border-style: dashed;
    box-shadow: none;
  }

  .feliz-card__elige {
    font-size: 0.85rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text));
  }

  .felices__nota {
    text-align: center;
    margin: 26px 0 0;
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--la-wine, var(--color-foreground));
  }

  .felices__vacio {
    text-align: center;
    font-size: 0.95rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text));
  }

  @media (prefers-reduced-motion: reduce) {
    .felices__grid--girado .feliz-card,
    .felices__grid--girado .feliz-card:nth-child(even) {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Finales felices",
  "settings": [
    {
      "type": "text",
      "id": "fina",
      "label": "Entradilla (cursiva)",
      "default": "sí, esto acaba bien"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Finales felices"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Texto introductorio",
      "default": "Los que ya salieron por la puerta grande. Este muro crece con cada adopción."
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        { "value": "1", "label": "t:options.one_number" },
        { "value": "2", "label": "t:options.two_number" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Tarjetas"
    },
    {
      "type": "checkbox",
      "id": "girar",
      "label": "Girar tarjetas (efecto polaroid)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_sello",
      "label": "Mostrar sello «Adoptado/a»",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_anio",
      "label": "Añadir el año al sello",
      "default": true,
      "visible_if": "{{ section.settings.mostrar_sello }}"
    },
    {
      "type": "header",
      "content": "Relleno automático"
    },
    {
      "type": "paragraph",
      "content": "Sin bloques «Animal adoptado», el muro se rellena solo con los animales en estado «adoptado»."
    },
    {
      "type": "range",
      "id": "max_animales",
      "label": "Máximo en modo automático",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8
    },
    {
      "type": "text",
      "id": "nota",
      "label": "Nota final",
      "default": "el próximo nombre de este muro lo decides tú 🤍"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 78
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 78
    }
  ],
  "blocks": [
    {
      "type": "animal",
      "name": "Animal adoptado",
      "settings": [
        {
          "type": "metaobject",
          "id": "animal",
          "metaobject_type": "animal",
          "label": "Animal",
          "info": "Elige uno con estado «adoptado» (si no lo está, el editor te avisará)."
        },
        {
          "type": "text",
          "id": "frase",
          "label": "Frase de su familia",
          "info": "Opcional, en cursiva bajo el sello: «ahora duerme en el sofá»."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Finales felices",
      "category": "t:categories.storytelling",
      "blocks": [
        { "type": "animal" },
        { "type": "animal" },
        { "type": "animal" },
        { "type": "animal" }
      ]
    }
  ]
}
{% endschema %}
