{% comment %}
  Franja de impacto: la banda «¿A dónde va exactamente tu compra?» con la cifra
  grande a la izquierda, la explicación en medio y el botón a la derecha.
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    {% render 'paleta-vars' %}
    --franja-padding-top: {{ section.settings.padding-block-start }}px;
    --franja-padding-bottom: {{ section.settings.padding-block-end }}px;
    --franja-max: {{ section.settings.max_width }}px;
    --franja-radius: {{ section.settings.corner_radius }}px;
    {%- if section.settings.background_color != blank %}
    --franja-bg: var(--color-background);
    {%- endif %}
    {%- if section.settings.number_color != blank %}
    --franja-number: {{ section.settings.number_color }};
    {%- endif %}
  }
</style>

<div class="franja-wrap">
  <div
    class="franja{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% unless section.settings.borde %} franja--sin-borde{% endunless %}"
  >
    {% if section.settings.cifra != blank %}
      <span class="franja__big">{{ section.settings.cifra }}</span>
    {% endif %}

    <div class="franja__txt">
      {% if section.settings.titulo != blank %}
        <h2 class="franja__titulo">{{ section.settings.titulo }}</h2>
      {% endif %}
      {% if section.settings.texto != blank %}
        <div class="franja__cuerpo rte">{{ section.settings.texto }}</div>
      {% endif %}
    </div>

    {% if section.settings.boton_texto != blank %}
      <a
        class="franja__btn button{% if section.settings.boton_estilo == 'secundario' %} button-secondary{% endif %}"
        href="{{ section.settings.boton_enlace | default: '#' }}"
      >
        {{ section.settings.boton_texto }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .franja-wrap {
    padding-block: var(--franja-padding-top, 0) var(--franja-padding-bottom, 0);
    padding-inline: var(--page-margin);
  }

  .franja {
    max-width: var(--franja-max, 1180px);
    margin-inline: auto;
    background: var(--franja-bg, var(--la-nude, var(--color-background)));
    color: var(--color-foreground);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: var(--franja-radius, 4px);
    padding: 34px 36px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 26px;
    align-items: center;
  }

  .franja--sin-borde {
    border-color: transparent;
  }

  .franja__big {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: clamp(2.4rem, 1.9rem + 2.2vw, 3.4rem);
    line-height: 1;
    color: var(--franja-number, var(--la-wine, var(--color-foreground)));
  }

  .franja__titulo {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .franja__cuerpo {
    margin-block-start: 8px;
    font-size: 0.94rem;
    line-height: 1.6;
    max-width: 44em;
  }

  .franja__cuerpo p {
    margin: 0;
  }

  .franja__cuerpo p + p {
    margin-block-start: 0.6em;
  }

  .franja__btn {
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .franja {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 26px 22px;
      justify-items: center;
    }

    .franja__cuerpo {
      margin-inline: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Franja de impacto",
  "settings": [
    {
      "type": "text",
      "id": "cifra",
      "label": "Cifra",
      "default": "15 €"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "¿A dónde va exactamente tu compra?"
    },
    {
      "type": "richtext",
      "id": "texto",
      "label": "Texto",
      "default": "<p>Una camiseta cubre <strong>una semana de pienso</strong> de un perro grande. Una sudadera, <strong>una desparasitación completa</strong>. Un totebag, <strong>una vacuna</strong>. No es marketing: es la cuenta que hacemos cada mes para que ninguno se quede sin lo suyo.</p>"
    },
    {
      "type": "text",
      "id": "boton_texto",
      "label": "Texto del botón",
      "default": "Ver a quién ayudas"
    },
    {
      "type": "url",
      "id": "boton_enlace",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "boton_estilo",
      "label": "Estilo del botón",
      "options": [
        { "value": "primario", "label": "t:options.primary" },
        { "value": "secundario", "label": "t:options.secondary" }
      ],
      "default": "primario"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "borde",
      "label": "Borde",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Color de la cifra",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Franja de impacto",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
