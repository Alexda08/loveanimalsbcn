{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  # LA START
  # La portada tiene título y descripción propios, en los ajustes del tema. Los de
  # Tienda online → Preferencias eran los de la tienda vieja («Camisetas
  # animalistas…») y la API no deja cambiarlos, así que aquí mandan estos.
  assign la_titulo = page_title
  assign la_descripcion = page_description
  if request.page_type == 'index'
    if settings.titulo_home != blank
      assign la_titulo = settings.titulo_home
      assign og_title = settings.titulo_home
    endif
    if settings.descripcion_home != blank
      assign la_descripcion = settings.descripcion_home
      assign og_description = settings.descripcion_home
    endif
  endif
  # LA END

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  # LA START
  # Shopify solo llena `page_image` en producto, colección y artículo. Las
  # fichas de los animales y los álbumes son metaobjetos, así que al compartir
  # una ficha por WhatsApp o Instagram salía sin foto — justo lo que la web
  # pide hacer («muchas adopciones empiezan con un like o un repost»).
  # `.value.first` no vale con las listas de referencias: hay que recorrerlas.
  assign la_imagen = page_image
  if la_imagen == blank and request.page_type == 'metaobject'
    for f in metaobject.galeria.value limit: 1
      assign la_imagen = f.preview_image
    endfor
    if la_imagen == blank and metaobject.portada.value != blank
      assign la_imagen = metaobject.portada.value.preview_image
    endif
  endif
  # y para lo que no tiene foto propia (la home, la tienda, las páginas de
  # texto), la tarjeta de la asociación: compartir el enlace sin nada es
  # perder la mitad del mensaje
  if la_imagen == blank
    assign la_imagen = settings.imagen_social
  endif
  # LA END
-%}

{%- if la_imagen != blank -%}
  <meta
    property="og:image"
    content="http:{{ la_imagen | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ la_imagen | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ la_imagen.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ la_imagen.height }}"
  >
  {%- if la_imagen.alt != blank -%}
    <meta
      property="og:image:alt"
      content="{{ la_imagen.alt | escape }}"
    >
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if la_imagen != blank -%}
  {%- comment -%} LA START: sin esto la tarjeta de Twitter/X salía sin foto {%- endcomment -%}
  <meta
    name="twitter:image"
    content="https:{{ la_imagen | image_url: width: 1200 }}"
  >
  {%- comment -%} LA END {%- endcomment -%}
{%- endif -%}

<title>
  {{ la_titulo }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless la_titulo contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if la_descripcion %}
  <meta
    name="description"
    content="{{ la_descripcion | escape }}"
  >
{% endif %}
