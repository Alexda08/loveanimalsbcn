                "text_J6raqX": {
                  "type": "text",
                  "settings": {
                    "text": "<h1>¿Cómo se tramita la licencia PPP?</h1>",
                    "width": "fit-content",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
